# Copiá este archivo a .env y completá los valores.
# Las variables sin default son obligatorias para que la app arranque.

# --- Servidor ---
# NODE_ENV selecciona la configuración de knexfile.js (development | production).
NODE_ENV=development
PORT=3001

# --- Base de datos ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=split_expenses
DB_USER=postgres
DB_PASSWORD=postgres

# Solo producción: si está definida, tiene prioridad sobre las DB_* de arriba.
# DATABASE_URL=postgres://usuario:password@host:5432/split_expenses

# --- Autenticación ---
# Obligatorias y sin default. Firman el access token (15 min) y el refresh (7 días).
# Generá cada una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- Frontend ---
# Origen permitido por CORS. Si se omite, se usa FRONTEND_URL y, en su defecto,
# http://localhost:5173
CORS_ORIGIN=http://localhost:5173
# Base de los enlaces que se envían por email (invitaciones, recupero de contraseña).
FRONTEND_URL=http://localhost:5173

# --- Email (Resend) ---
# Opcional: sin RESEND_API_KEY la app funciona igual, pero omite el envío de
# emails y deja un warning en consola.
RESEND_API_KEY=
EMAIL_FROM=Splitio <onboarding@resend.dev>
