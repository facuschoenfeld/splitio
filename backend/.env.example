# Copiá este archivo a .env y completá los valores.
# Las variables sin default son obligatorias para que la app arranque.

# --- Servidor ---
# NODE_ENV selecciona la configuración de knexfile.js (development | production).
NODE_ENV=development
PORT=3001
# Saltos de proxy en los que confía Express para leer la IP real del cliente
# (X-Forwarded-For), que usa el rate limit de /api/auth. Default 1, el valor
# correcto detrás del proxy de Render. Con 0 se ignora el header.
# TRUST_PROXY=1

# --- Base de datos ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=split_expenses
DB_USER=postgres
DB_PASSWORD=postgres

# Solo producción: si está definida, tiene prioridad sobre las DB_* de arriba.
# Con Neon usá la connection string directa (sin "-pooler" en el host):
# DATABASE_URL=postgresql://usuario:password@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# --- Autenticación ---
# Obligatorias y sin default. Firman el access token (15 min) y el refresh (7 días).
# Generá cada una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- Frontend ---
# Origen(es) permitido(s) por CORS, separados por coma. Si se omite, se usa
# FRONTEND_URL y, en su defecto, http://localhost:5173
CORS_ORIGIN=http://localhost:5173
# Base de los enlaces que se envían por email (invitaciones, recupero de contraseña).
FRONTEND_URL=http://localhost:5173

# --- Email (Resend) ---
# Opcional: sin RESEND_API_KEY la app funciona igual, pero omite el envío de
# emails y deja un warning en consola.
RESEND_API_KEY=
# onboarding@resend.dev solo entrega a la dirección dueña de la cuenta de Resend.
# Para enviar a cualquiera, verificá un dominio en Resend y usá una dirección de él:
# EMAIL_FROM=Splitio <no-reply@mail.tudominio.com>
EMAIL_FROM=Splitio <onboarding@resend.dev>
